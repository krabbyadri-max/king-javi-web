<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | King Javi</title>
    <meta name="description" content="{{ excerpt or 'Comunidad King Javi — 3D, rigging, animación y desarrollo de videojuegos.' }}">
    <meta name="author" content="Javier Torralba Sánchez">
    <meta property="og:title" content="{{ title }} | King Javi">
    <meta property="og:description" content="{{ excerpt or 'Comunidad King Javi — 3D, rigging, animación y desarrollo de videojuegos.' }}">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:image" content="{{ '/assets/img/og-image.jpg' | url }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="{{ '/assets/img/og-image.jpg' | url }}">
    <link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
    <style>
        /* Blog/comunidad — estilos propios sobre el tema del landing */
        .blog-wrap { max-width: 760px; margin: 0 auto; padding: 7rem 1.5rem 4rem; }
        .blog-back { display: inline-block; margin-bottom: 2rem; color: var(--gold); text-decoration: none; font-weight: 600; }
        .blog-back:hover { text-decoration: underline; }
        .blog-header h1 { font-family: 'Montserrat', sans-serif; font-size: clamp(1.8rem, 5vw, 2.8rem); line-height: 1.15; margin-bottom: 0.75rem; }
        .post-meta { color: var(--gray); font-size: 0.95rem; margin-bottom: 0.5rem; }
        .post-tags { margin: 0.5rem 0 2.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .post-tag { font-size: 0.8rem; color: var(--gold); border: 1px solid rgba(212, 175, 55, 0.4); border-radius: 999px; padding: 0.15rem 0.7rem; }
        .post-body { font-size: 1.05rem; line-height: 1.75; color: #e6e6e6; }
        .post-body h2 { font-family: 'Montserrat', sans-serif; margin: 2.2rem 0 0.8rem; color: var(--white); }
        .post-body h3 { font-family: 'Montserrat', sans-serif; margin: 1.8rem 0 0.6rem; color: var(--white); }
        .post-body p { margin-bottom: 1.1rem; }
        .post-body ul, .post-body ol { margin: 0 0 1.1rem 1.4rem; }
        .post-body li { margin-bottom: 0.4rem; }
        .post-body a { color: var(--gold); }
        .post-body code { background: rgba(255,255,255,0.08); padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
        .post-body pre { background: #161616; border: 1px solid rgba(212,175,55,0.15); border-radius: 8px; padding: 1rem; overflow-x: auto; margin-bottom: 1.2rem; }
        .post-body pre code { background: none; padding: 0; }
        .post-body strong { color: var(--white); }
        /* Listado */
        .post-list { list-style: none; margin: 0; padding: 0; }
        .post-list-item { border-top: 1px solid rgba(212, 175, 55, 0.15); padding: 1.6rem 0; }
        .post-list-item:last-child { border-bottom: 1px solid rgba(212, 175, 55, 0.15); }
        .post-list-item h2 { font-family: 'Montserrat', sans-serif; font-size: 1.4rem; margin-bottom: 0.4rem; }
        .post-list-item h2 a { color: var(--white); text-decoration: none; }
        .post-list-item h2 a:hover { color: var(--gold); }
        .post-list-item .excerpt { color: #cfcfcf; margin-top: 0.4rem; }
        .blog-empty { color: var(--gray); padding: 2rem 0; }
        .post-comments { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid rgba(212, 175, 55, 0.15); }
    </style>
</head>
<body>
    <!-- Navigation (versión simplificada para el blog) -->
    <nav id="navbar">
        <a href="{{ '/' | url }}" class="logo">
            <img src="{{ '/assets/img/king-javi-hero.webp' | url }}" alt="King Javi" width="45" height="45">
            <div>
                <div class="logo-text">KING JAVI</div>
                <div class="logo-sub">3D &amp; Game Dev</div>
            </div>
        </a>
        <ul class="nav-links">
            <li><a href="{{ '/' | url }}">Inicio</a></li>
            <li><a href="{{ '/comunidad/' | url }}">Comunidad</a></li>
            <li><a href="{{ '/#contact' | url }}">Contacto</a></li>
        </ul>
        <a href="{{ '/#contact' | url }}" class="nav-cta">Clase GRATIS</a>
    </nav>

    <main class="blog-wrap">
        {{ content | safe }}
    </main>

    <footer>
        <div class="footer-content">
            <div class="footer-links">
                <a href="{{ '/' | url }}">Inicio</a>
                <a href="{{ '/comunidad/' | url }}">Comunidad</a>
                <a href="{{ '/#contact' | url }}">Contacto</a>
                <a href="https://www.artstation.com/javielmenda">ArtStation</a>
            </div>
            <p>© 2025 King Javi - Javier Torralba Sánchez | Todos los derechos reservados</p>
        </div>
    </footer>
</body>
</html>
